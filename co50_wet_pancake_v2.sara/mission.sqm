		class Item41
		{
			dataType = "Comment";
			class PositionInfo
			{
				position[] = {11027.982,170.285,9245.07};
			};
			title = "Note on Guard Triggers";
			description = "The order the triggers are places indicates to the AI which ""Guard Point"" has the most priority. So if both WP six and three were unoccupied, the AI would send troops to WP three since that has a higher priority." \n "" \n "(As mentioned above, numbering is based on the order placed, so the first trigger you place that has ""Guarded by X"" will have the highest priority and so on and so forth.)";
