		[arsenal, (_itemGear + _itemUniform + _itemVest + _itemHeadgear + _itemBackpack + _itemCosmetic + _itemMisc + _itemAcc + _itemWeapSRifle + _itemAmmo + _itemExplosive)] call ace_arsenal_fnc_initBox;
