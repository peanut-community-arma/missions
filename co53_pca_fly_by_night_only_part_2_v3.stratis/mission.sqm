									value = "params [""_wave"",""_spawnedGroups"",""_spawnedUnits"",""_spawnedVehicles"",""_spawnedObjects"",""_logic"",""_wavehandlerID""];" \n "  {_x setVariable [""lambs_danger_dangerRadio"", true, true]} forEach _spawnedUnits; " \n " " \n "{_x setVariable [""lambs_danger_enableGroupReinforce"", true, true]} forEach _spawnedUnits; " \n " " \n "{_x setVariable [""lambs_danger_enableGroupReinforce"", true, true]} forEach _spawnedGroups;  " \n "" \n "{ " \n "  [_x, [], 100, true, true, -2, false] call pca_fnc_garrisonArea" \n ";} forEach _spawnedGroups;";
