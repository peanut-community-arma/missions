		class Item169
		{
			dataType = "Layer";
			name = "Annotations by veer (from V1)";
			state = 2;
			class Entities
			{
				items = 17;
				class Item0
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {13112.88,91.21875,8900.496};
					};
					title = "Consider moving some QRF EI here";
					id = 1308;
					atlOffset = -4.696007;
				};
				class Item1
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {12730.348,68.644,9169.062};
					};
					title = "This can be 2x 8-man squads";
					description = "In general, unless you have a compelling reason to split up the groups, don't. In this case, there's not much call to split them up since they are all moving in the same direction, very close together." \n "" \n "Having 15x guys conga-lining out of the same rock is also very odd and extremely easy to handle.";
					id = 1307;
					atlOffset = 1.714035;
				};
				class Item2
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {12858.672,67.642,9880.557};
					};
					title = "Distribute north QRF infantry among ALL tree clusters, not just one";
					description = "Reference my OPFOR Infantry markers. Having 3 squads coming from the same clump of forest makes it really easy to deal with them since a single player can see all of them without even needing to turn around.";
					id = 1312;
					atlOffset = -0.24537659;
				};
				class Item3
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {12383.027,118.69946,9763.162};
					};
					title = "Single vics aren't scary - vics should have an infantry screen";
					description = "Spawn the ""accompanying"" infantry closer to the players so that they arrive at around the same time. The forest where this comment is would be a great location.";
					id = 1321;
					atlOffset = -0.1100235;
				};
				class Item4
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {13664.275,94.895,8941.754};
					};
					title = "Use the WHOLE space!";
					description = "Spread out your southern flankers along the WHOLE south - you're only using about 300m, but you have a cool 500-600m to work with. If they're on HUNT way points, even better, they will organically swing in from the east.";
					id = 1322;
					atlOffset = -0.0001296997;
				};
				class Item5
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {14134.015,51.788,9548.762};
					};
					title = "Needs many more patrols (CIV units used to mark possible early patrol)";
					description = "This whole forest is ""dead space"" at the moment. You can easily space out the patrols for a bit of light contact as the platoon moves through.";
					id = 1323;
					atlOffset = 13.288544;
				};
				class Item6
				{
					dataType = "Comment";
					class PositionInfo
					{
						position[] = {14438.58,14.173096,9988.518};
					};
					title = "30s between waves is VERY fast";
					description = "Either set a higher % casualty threshold (~75% - 80%) or set it at minimum to 60s" \n "" \n "You especially don't want it to spawn fast if the spawn locations are going to be close to players, and these are very close indeed";
					id = 1359;
					atlOffset = 4.2227106;
				};
