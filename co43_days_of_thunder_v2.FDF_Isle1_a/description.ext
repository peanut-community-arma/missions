};

class Extended_PreInit_EventHandlers 
{
	class pca_preInit 
	{
		init = "[] call compile preprocessFileLineNumbers 'XEH_PreInit.sqf'";
	};
};

class Extended_PostInit_EventHandlers 
{
	class pca_postInit 
	{
		init = "[] call compile preprocessFileLineNumbers 'XEH_PostInit.sqf'";
	};
};

//////////////////////////////////////////
//McCOY'S AUTOMAGICAL LOADOUT ASSIGNMENT//
//////////////////////////////////////////
//place these event handlers in your description.ext to automatically assign gear to specific factions on spawn
//great for zeusing
//if i can get it to work
class Extended_InitPost_EventHandlers
{

////////////////////////
///ARDISTANI AIRBORNE///
////////////////////////
		//rifleman
		class Atlas_I_AR_Soldier_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['rm'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
			};
		};
		//radioman (spawns as rifleman)
		class Atlas_I_AR_RadioOperator_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['rm'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
			};
		};
		//lite rifleman (now regular rifleman)
		class Atlas_I_AR_Soldier_Lite_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['rm'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
			};
		};
		//loadbearing
		class Atlas_I_AR_Soldier_A_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['lb'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
			};
		};
		//AAR
		class Atlas_I_AR_Soldier_AAR_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['aar'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
			};
		};
		//AAA - spawned as regular AA due to iglas being single shot
		class Atlas_I_AR_Soldier_AAA_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['rm_aa'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
			};
		};
		//AR - spawns in as either M249 or PKP gunner due to regular Aegis Ardistani troops not having MGs for some reason
		class Atlas_I_AR_Soldier_AR_F
		{
			class varInit
			{
				init = "private _role = selectRandom ['mg','ar'];[_this select 0, 'OPFOR_LOADOUT', _role] call tmf_assigngear_fnc_assigngear;";
