				name = "mayoiga_vis";
				condition = "player in thisList && {isNil ""mayoigaSpent""}";
				onActivation = "private _check = 1; " \n "while {!isNil '_check'} do { " \n "  private _x = missionNamespace getVariable [('mayoiga_' + str _check), nil]; " \n "  if (isNil '_x') exitWith {_check = nil;}; " \n "  _x hideObject false; " \n "  _check = _check + 1; " \n "};";
				onDeactivation = "player spawn { params ['_player']; while {_player distance2D mayoiga_1 < 100 || {" \n "    private _look = getCameraViewDirection _player; " \n "_look params ['_x','_y','_z']; " \n "_x < -0.45 && {_y > -0.63 && {_y < 0.85 && { (abs _z) < 0.55}}}}" \n "} do {sleep 1};" \n "private _check = 1; " \n "while {!isNil '_check'} do { " \n "  private _x = missionNamespace getVariable [('mayoiga_' + str _check), nil]; " \n "  if (isNil '_x') exitWith {_check = nil;}; " \n "  _x hideObject true; " \n "  _check = _check + 1; " \n "};};";
				sizeA = 2.398;
				sizeB = 1.005;
