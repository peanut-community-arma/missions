			class Attributes
			{
				onActivation = "thisTrigger call { " \n "    private _offset = ([(triggerArea _this) # 0, random 360, 0] call CBA_fnc_polar2vect); " \n "    ""SmokeShellRed"" createVehicle (position _crate); " \n " " \n "    [""AirWarning"", []] remoteExec [""BIS_fnc_showNotification""]; " \n "    (_offset vectorAdd (getPos thisTrigger)) call { " \n "        private _flarePos = _this vectorAdd [0, 0, 220]; " \n "        private _flare = createVehicle [""CUP_F_40mm_Star_Red"", _flarePos, [], 0, ""none""]; " \n "        _flare setVelocity [wind select 0, wind select 1, 30]; " \n " " \n "        ""SmokeShellRed"" createVehicle _this; " \n "    }; " \n " " \n "    [  " \n "        {  " \n "            private _grp = createGroup sideLogic;    " \n "            ""ModuleCAS_F"" createUnit [    " \n "             (getPos (_this # 0)) vectorAdd (_this # 1),    " \n "             _grp,    " \n "             ""this setVariable ['vehicle','I_Plane_Fighter_03_CAS_F',true];this setDir 170;this setVariable ['type', 1, true];this setVariable ['BIS_fnc_initModules_disableAutoActivation', false, true];""    " \n "            ];   " \n "            _grp deleteGroupWhenEmpty true;  " \n "            deleteVehicle (_this # 0);  " \n "        },  " \n "        [_this, _offset],  " \n "        20  " \n "    ] call CBA_fnc_waitAndExecute; " \n "}";
				sizeA = 40.0;
				sizeB = 40.0;
