class CfgCommunicationMenu
{
	class friendlyMortar
	{
		text = "Mortar Barrage";		// Text displayed in the menu and in a notification
		submenu = "";					// Submenu opened upon activation (expression is ignored when submenu is not empty.)
		expression = "_pos call DNV_fnc_mortarBarrage;";	// Code executed upon activation
		icon = "\a3\Ui_f\data\GUI\Cfg\CommunicationMenu\mortar_ca.paa";				// Icon displayed permanently next to the command menu
		cursor = "\a3\Ui_f\data\IGUI\Cfg\Cursors\iconCursorSupport_ca.paa";				// Custom cursor displayed when the item is selected
		enable = "cursorOnGround";					// Simple expression condition for enabling the item
		removeAfterExpressionCall = 0;	// 1 to remove the item after calling
	};
};

class Params
{
	class DNV_MortarCooldown
	{
		title = "Mortar Barrage cooldown";
		texts[] = { "Five Minutes", "Ten Minutes", "Twenty Minutes" };
		values[] = { 300, 600, 1200 };
		default = 600;
	};
    class Daytime
	{
		title = "Time";
		texts[] = {"Midnight (!)","Dark Start","Sunrise","Noon","Sunset"};
		values[] = {0,5,6,12,17};
		default = 6;
		function = "BIS_fnc_paramDaytime";
	};
};

