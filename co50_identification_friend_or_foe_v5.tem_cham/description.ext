/*
    All this just plays an ambient radio static noise when approaching one of
    the intel pickup objects. (It's a CBA state machine, see initserver)
*/
class DNV_RadioSM
{
    list = "[radio1, radio2, radio3, radio4]";
    skipNull = 1;

    class Waiting {
        onState = "";
        onStateEntered = "";
        onStateLeaving = "";

        class PlayerNear {
            targetState = "Playing";
            condition = "{_x distance _this < 300} count (call BIS_fnc_listPlayers) > 0";
            onTransition = "";
        };
    };

    class Playing {
        onState = "if (CBA_missionTime - (_this getVariable ['DNV_lastPlayed', 0]) > (15 + random 5)) then { \
            playSound3D [(selectRandom [   \
                    'a3\dubbing_radio_f\sfx\radionoise1.ogg',\
                    'a3\dubbing_radio_f\sfx\radionoise2.ogg',\
                    'a3\dubbing_radio_f\sfx\radionoise3.ogg' \
                ]),    \
                _this, \
                false, \
                getPosASL _this, \
                3.25 \
            ]; \
            _this setVariable ['DNV_lastPlayed', CBA_missionTime]; \
        };";
        onStateEntered = "";
        onStateLeaving = "";
        
        class PlayerLeft {
            targetState = "Waiting";
            condition = "{_x distance _this < 300} count (call BIS_fnc_listPlayers) < 1";
            onTransition = "";
        };
        
        class PickedUp {
            targetState = "IntelFound";
            condition = "_this getVariable ['DNV_IntelFound', false]";
            onTransition = "";
        };
    };
    
    class IntelFound {};
};