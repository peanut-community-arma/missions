class Extended_InitPost_EventHandlers
{
    #include "loadouts\auto_equip.hpp"
    class CUP_M60A3_Base
    {
        class addCoax // because the m60 starts with invalid coax ammo by default
        {
            init = "if (!isServer) exitWith {};for '_mg' from 1 to 6 do {(_this # 0) addMagazineTurret ['CUP_2800Rnd_TE4_Red_Tracer_762x51_M240_M', [0]]};\
                    for '_can' from 1 to 3 do {(_this # 0) addMagazineTurret ['CUP_1Rnd_TE1_Red_Tracer_105mm_M1040_M68_Cannon_M', [0]]}";
        };
    };
};

