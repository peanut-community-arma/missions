						class Attribute4
						{
							property = "TMF_ai_wavespawn_WaveInit";
							expression = "                                                                                                                                                                                if (_value != 'params [""_wave"", ""_spawnedGroups"", ""_spawnedUnits"", ""_spawnedVehicles"", ""_spawnedObjects"", ""_logic"", ""_wavehandlerID""];' && _value != '') then {                     [_this, compile _value, True] call TMF_ai_fnc_addWaveHandler;                                                                                                                              };                                                                                                                                                                                         ";
							class Value
							{
								class data
