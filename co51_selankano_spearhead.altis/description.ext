class Extended_PreInit_EventHandlers 
{
	class pca_preInit 
	{
		init = "[] call compile preprocessFileLineNumbers 'XEH_PreInit.sqf'";
	};
};

class Extended_PostInit_EventHandlers 
{
	class pca_postInit 
	{
		init = "[] call compile preprocessFileLineNumbers 'XEH_PostInit.sqf'";
	};
};

class Extended_Init_EventHandlers
{
	class O_G_Soldier_F
	{
		class varInit
		{
			init = "[_this select 0, 'OPFOR_LOADOUT', 'rm'] call tmf_assigngear_fnc_assigngear;";
		};
	};
	class O_G_Soldier_AR_F
	{
		class varInit
		{
			init = "[_this select 0, 'OPFOR_LOADOUT', 'mg'] call tmf_assigngear_fnc_assigngear;";
		};
	};
	class O_G_Soldier_A_F
	{
		class varInit
		{
			init = "[_this select 0, 'OPFOR_LOADOUT', 'ar'] call tmf_assigngear_fnc_assigngear;";
		};
	};
	class O_G_Soldier_LAT_F
	{
		class varInit
		{
			init = "[_this select 0, 'OPFOR_LOADOUT', 'rm_mat'] call tmf_assigngear_fnc_assigngear;";
		};
	};
	class O_G_Soldier_LAT2_F
	{
		class varInit
		{
			init = "[_this select 0, 'OPFOR_LOADOUT', 'rm_lat'] call tmf_assigngear_fnc_assigngear;";
		};
	};
};